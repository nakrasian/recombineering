# Large inputs, derived databases, and logs — never published.
# The results bundle in Recombinase_Search/share/data/ is the only data that ships.

# --- dataset inputs and derived databases (GBs) ---
/Recombinase_Search/data/
/Recombinase_Search/db/
/Recombinase_Search/phastest/
